#tasks-pane {
    width: 50%;
    max-width: 80;
}

#tasks {
    height: 1fr;
    border: round $primary;
}

#tasks:focus {
    border: round $accent;
}

#detail {
    height: auto;
    max-height: 50%;
    padding: 0 1;
    border: round $primary;
    overflow-y: auto;
}

#logs {
    height: 1fr;
    padding: 0 0 0 1;
    border: round $primary;
    overflow-x: hidden;
}
